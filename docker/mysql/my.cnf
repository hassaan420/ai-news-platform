# MySQL Production-Hardened Configuration
# CIS MySQL 8.0 Benchmark compliant
# See DATABASE_SCHEMA.md §1 and DOCKER.md §3

[mysqld]
# ─── Character Set ────────────────────────────────────────────
character-set-server       = utf8mb4
collation-server           = utf8mb4_unicode_ci
init-connect               = 'SET NAMES utf8mb4'

# ─── Timezone ────────────────────────────────────────────────
default-time-zone          = '+00:00'

# ─── InnoDB Production Tuning ─────────────────────────────────
innodb_buffer_pool_size        = 256M
innodb_buffer_pool_instances   = 2
innodb_log_file_size           = 128M
innodb_log_buffer_size         = 16M
innodb_flush_log_at_trx_commit = 1      # ACID: flush to disk on every commit
innodb_file_per_table          = 1
innodb_flush_method            = O_DIRECT
innodb_read_io_threads         = 4
innodb_write_io_threads        = 4
innodb_io_capacity             = 200

# ─── Slow Query Log ──────────────────────────────────────────
slow_query_log             = 1
slow_query_log_file        = /var/log/mysql/slow.log
long_query_time            = 1          # Flag queries > 1s (was 2s)
log_queries_not_using_indexes = 1       # Flag full-table scans

# ─── General Query Log (AUDIT — enable only in prod for compliance) ──
# general_log              = 1
# general_log_file         = /var/log/mysql/general.log

# ─── Error Log ───────────────────────────────────────────────
log_error                  = /var/log/mysql/error.log
log_error_verbosity        = 3

# ─── Connection Limits ───────────────────────────────────────
max_connections            = 200
max_connect_errors         = 10
wait_timeout               = 28800
interactive_timeout        = 28800
connect_timeout            = 10

# ─── Security: Disable Dangerous Features ────────────────────
local_infile               = 0          # CRITICAL: Prevent LOCAL INFILE attacks
secure-file-priv           = '/var/lib/mysql-files'
skip_symbolic_links        = 1
symbolic-links             = 0

# ─── Binary Logging (Replication & PITR) ────────────────────
log_bin                        = mysql-bin
binlog_format                  = ROW
binlog_row_image               = FULL
binlog_expire_logs_seconds     = 604800  # 7 days (replaces deprecated expire_logs_days)
max_binlog_size                = 100M
sync_binlog                    = 1       # Flush binlog to disk on every write

# ─── SSL/TLS Enforcement ─────────────────────────────────────
# Enable SSL for encrypted connections (certs mounted via Docker volume)
# ssl_ca     = /etc/mysql/certs/ca.pem
# ssl_cert   = /etc/mysql/certs/server-cert.pem
# ssl_key    = /etc/mysql/certs/server-key.pem
# require_secure_transport = ON   # Uncomment in production with real certs

# ─── Performance: Query Cache (DISABLED in MySQL 8.0) ────────
# query_cache_type = 0  # Already default in MySQL 8.0

# ─── Thread & Memory ─────────────────────────────────────────
thread_cache_size          = 8
table_open_cache           = 2000
table_definition_cache     = 1400
join_buffer_size           = 512K
sort_buffer_size           = 512K
read_buffer_size           = 512K
read_rnd_buffer_size       = 256K
tmp_table_size             = 64M
max_heap_table_size        = 64M

[client]
default-character-set      = utf8mb4

[mysql]
default-character-set      = utf8mb4

# MySQL configuration for AI News Platform
# Mounted at /etc/mysql/conf.d/my.cnf
# See DATABASE_SCHEMA.md §1 and DOCKER.md §3

[mysqld]
# ─── Character Set (enforced globally) ───────────────────────
character-set-server       = utf8mb4
collation-server           = utf8mb4_unicode_ci
init-connect               = 'SET NAMES utf8mb4'

# ─── Timezone ────────────────────────────────────────────────
default-time-zone          = '+00:00'

# ─── InnoDB Tuning (containerized) ───────────────────────────
innodb_buffer_pool_size    = 256M
innodb_log_file_size       = 64M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table      = 1

# ─── Slow Query Log ─────────────────────────────────────────
slow_query_log             = 1
slow_query_log_file        = /var/log/mysql/slow.log
long_query_time            = 2

# ─── Connection Limits ──────────────────────────────────────
max_connections            = 200
wait_timeout               = 28800
interactive_timeout        = 28800

# ─── Binary Logging (replication readiness) ──────────────────
log_bin                    = mysql-bin
binlog_format              = ROW
expire_logs_days           = 7

[client]
default-character-set      = utf8mb4

[mysql]
default-character-set      = utf8mb4

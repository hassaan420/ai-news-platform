{
  "title": "JVM & Application Metrics",
  "timezone": "browser",
  "schemaVersion": 30,
  "refresh": "10s",
  "panels": [
    {
      "title": "JVM Heap Used",
      "type": "timeseries",
      "targets": [{"expr": "jvm_memory_used_bytes{area=\"heap\"}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "targets": [{"expr": "system_cpu_usage", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "HTTP Requests (Throughput)",
      "type": "timeseries",
      "targets": [{"expr": "rate(http_server_requests_seconds_count[1m])", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "title": "HTTP 5xx Error Rate",
      "type": "timeseries",
      "targets": [{"expr": "rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "title": "GC Pause Time",
      "type": "timeseries",
      "targets": [{"expr": "rate(jvm_gc_pause_seconds_sum[1m])", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "title": "Latency (95th Percentile)",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "title": "Cache Hit Ratio",
      "type": "stat",
      "targets": [{"expr": "sum(rate(cache_gets_total{result=\"hit\"}[1m])) / sum(rate(cache_gets_total[1m]))", "refId": "A"}],
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 24}
    }
  ]
}

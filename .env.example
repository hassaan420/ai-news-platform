# ─── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_USER=newsplatform
MYSQL_PASSWORD=changeme_db_password

# Per-service database names (created by init scripts)
AUTH_DB_NAME=auth_db
NEWS_DB_NAME=news_db
CATEGORY_DB_NAME=category_db
ADMIN_DB_NAME=admin_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_min_32_chars_long

# ─── Internal Service-to-Service API Key ──────────────────────
INTERNAL_API_KEY=changeme_internal_api_key

# ─── News Provider API Keys ──────────────────────────────────
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_KEY=your_gnews_key_here
MEDIASTACK_KEY=your_mediastack_key_here
GUARDIAN_KEY=your_guardian_key_here

# ─── Encryption (AES key for sources.api_key at rest) ────────
ENCRYPTION_KEY=changeme_aes256_encryption_key

# ─── Spring Profiles ─────────────────────────────────────────
# Overridden to 'dev' by docker-compose.override.yml (auto-loaded locally)
# Overridden to 'prod' by docker-compose.prod.yml (explicit -f flag)
SPRING_PROFILES_ACTIVE=prod

# ─── JVM Tuning ──────────────────────────────────────────────
# Override per-service via docker-compose.override.yml (dev) or
# docker-compose.prod.yml (prod). Leave empty for Dockerfile defaults.
JAVA_OPTS=

# ─── Docker Hub (CI/CD only — not used locally) ──────────────
# DOCKERHUB_NAMESPACE=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_access_token
